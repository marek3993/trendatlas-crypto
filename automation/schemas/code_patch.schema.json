{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodePatch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "patch_id",
    "created_at",
    "task_id",
    "run_id",
    "target_files",
    "reason",
    "patch_type",
    "proposed_changes",
    "validation_plan",
    "risk_level",
    "status"
  ],
  "properties": {
    "patch_id": { "type": "string" },
    "created_at": { "type": "string" },
    "task_id": { "type": "string" },
    "run_id": { "type": "string" },
    "target_files": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "reason": { "type": "string" },
    "patch_type": {
      "type": "string",
      "enum": [
        "replace_entire_file",
        "replace_exact_block"
      ]
    },
    "proposed_changes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "validation_plan": {
      "type": "object",
      "additionalProperties": true
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "approval_required"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "applied",
        "failed_apply"
      ]
    }
  }
}