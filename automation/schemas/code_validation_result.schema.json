{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeValidationResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "validation_id",
    "patch_id",
    "target_file",
    "validator_type",
    "command",
    "status",
    "stdout",
    "stderr",
    "validated_at"
  ],
  "properties": {
    "validation_id": { "type": "string" },
    "patch_id": { "type": "string" },
    "target_file": { "type": "string" },
    "validator_type": { "type": "string" },
    "command": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ]
    },
    "stdout": { "type": "string" },
    "stderr": { "type": "string" },
    "validated_at": { "type": "string" }
  }
}