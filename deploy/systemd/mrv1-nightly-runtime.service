[Unit]
Description=MRV1 nightly public status publisher (safe default, one pass)
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/market_regime_v1/.venv/bin/python
ConditionPathExists=/opt/market_regime_v1/scripts/execution/run_pi_authoritative_producer.py

[Service]
Type=oneshot
User=mrv1
Group=mrv1
WorkingDirectory=/opt/market_regime_v1
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/market_regime_v1/src:/opt/market_regime_v1/scripts
ExecStartPre=/opt/market_regime_v1/.venv/bin/python /opt/market_regime_v1/scripts/execution/run_pi_authoritative_producer.py --help
ExecStart=/opt/market_regime_v1/.venv/bin/python /opt/market_regime_v1/scripts/execution/run_pi_authoritative_producer.py
ExecStartPost=/usr/bin/test -f /opt/market_regime_v1/outputs/execution/authority/latest_attempt_status.json
ExecStartPost=/usr/bin/test -f /opt/market_regime_v1/outputs/execution/authority/latest_successful_snapshot.json
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mrv1-nightly-runtime
TimeoutStartSec=45min
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/market_regime_v1/data /opt/market_regime_v1/outputs
ReadOnlyPaths=/opt/market_regime_v1/source_of_truth
UMask=0027

[Install]
WantedBy=multi-user.target
