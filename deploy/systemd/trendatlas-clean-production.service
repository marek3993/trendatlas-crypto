[Unit]
Description=TrendAtlas Clean signal and TypeScript multi-account execution
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=trendatlas-clean
Group=trendatlas-clean
SupplementaryGroups=trendatlas-production
WorkingDirectory=/opt/trendatlas-clean/current
EnvironmentFile=/etc/trendatlas-production/multi-account.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TRENDATLAS_CLEAN_STATE_DIR=/var/lib/trendatlas-clean/state
Environment=TRENDATLAS_CLEAN_CONFIG=/etc/trendatlas-clean/policy.json
Environment=TRENDATLAS_NODE=@NODE@
ExecStart=/opt/trendatlas-clean/current/.venv/bin/python /opt/trendatlas-clean/current/scripts/production/run_clean_multi_account.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=6h
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=read-only
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/trendatlas-clean
UMask=0077
