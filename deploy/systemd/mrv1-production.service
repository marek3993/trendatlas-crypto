[Unit]
Description=TrendAtlas single production orchestrator
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/market_regime_v1/.venv/bin/python
ConditionPathExists=/opt/market_regime_v1/scripts/execution/run_trendatlas_production.py

[Service]
Type=oneshot
User=trendatlas
Group=trendatlas
WorkingDirectory=/opt/market_regime_v1
EnvironmentFile=-/etc/default/trendatlas-multi-account
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/market_regime_v1/src:/opt/market_regime_v1/scripts
Environment=MRV1_ENABLE_AUTHORITY_PUBLISH=1
Environment=MRV1_AUTHORITY_MODE=authoritative
Environment=MRV1_AUTOMATIC_PRODUCER_ID=raspberry_pi
Environment=MRV1_REQUIRE_PI_RUNTIME=1
Environment=MRV1_HYPERLIQUID_ACCOUNT_ADDRESS=0xAE8D1A44F5C32EcB235519A06bb6691a4B33E856
Environment=MRV1_EXECUTION_BACKEND=multi_account
Environment=MRV1_MULTI_ACCOUNT_WEB_ROOT=/opt/market_regime_v1/web
Environment=MRV1_MULTI_ACCOUNT_NODE_BINARY=/opt/market_regime_v1/.runtime/node-v22.23.2-linux-arm64/bin/node
Environment=TRENDATLAS_MULTI_ACCOUNT_MAX_CONCURRENCY=1
Environment="MRV1_AUTHORITY_PUBLISH_TREE=/home/trendatlas/mrv1_publish/market_regime_v1__authority_publish"
Environment="MRV1_AUTHORITY_GIT_USER_NAME=MRV1 Pi Authority"
Environment="MRV1_AUTHORITY_GIT_USER_EMAIL=mrv1-pi-authority@trendatlas.local"
ExecStartPre=/opt/market_regime_v1/.venv/bin/python /opt/market_regime_v1/scripts/execution/run_trendatlas_production.py --help
ExecStart=/opt/market_regime_v1/.venv/bin/python /opt/market_regime_v1/scripts/execution/run_trendatlas_production.py
ExecStartPost=/usr/bin/test -f /opt/market_regime_v1/outputs/execution/production_runs/latest_production_run.json
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mrv1-production
TimeoutStartSec=90min
Restart=on-failure
RestartSec=15min
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=read-only
ProtectSystem=strict
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/market_regime_v1/data /opt/market_regime_v1/outputs /home/trendatlas/mrv1_publish/market_regime_v1__authority_publish
ReadOnlyPaths=/opt/market_regime_v1/source_of_truth
UMask=0027

[Install]
WantedBy=multi-user.target
