{
  "schema_version": "research_os_mvp.v1",
  "runtime_profile": "pi_orchestrator",
  "role": "pi_orchestrator",
  "registry_path": "outputs/research_os/dev_only/mvp/registry/research_os_mvp.sqlite",
  "artifact_root": "outputs/research_os/dev_only/mvp/artifacts",
  "runtime_root": "outputs/research_os/dev_only/mvp/runtime",
  "required_env_vars": [
    "RESEARCH_OS_ROOT"
  ],
  "queue_backend": "redis_streams",
  "redis_url": "redis://127.0.0.1:6379/0",
  "streams": {
    "worker_jobs": "research_os:worker_jobs",
    "worker_results": "research_os:worker_results",
    "heavy_validation_jobs": "research_os:heavy_validation_jobs"
  },
  "consumer_group": "research_os_pc_workers",
  "consumer_name": "pi_orchestrator_01",
  "max_jobs_per_cycle": 1,
  "planner": {
    "enabled": true,
    "output_dir": "planner_outputs",
    "openai": {
      "enabled": false,
      "model": "gpt-5.4",
      "prompt_template": "research_os_planner_mutation_proposal_v1",
      "responses_api": "https://api.openai.com/v1/responses",
      "timeout_seconds": 60,
      "reasoning_effort": "medium",
      "reasoning_summary": "auto",
      "strict_schema_validation": true,
      "fail_closed": true
    }
  },
  "critic": {
    "enabled": true,
    "adapter_id": "safe_dev_only_family_verdict_critic_v1",
    "output_dir": "critic_outputs",
    "openai": {
      "enabled": false,
      "model": "gpt-5.4",
      "prompt_template": "research_os_critic_family_verdict_v1",
      "responses_api": "https://api.openai.com/v1/responses",
      "timeout_seconds": 60,
      "reasoning_effort": "medium",
      "reasoning_summary": "auto",
      "strict_schema_validation": true,
      "fail_closed": true
    }
  },
  "governor": {
    "enabled": true,
    "adapter_id": "safe_dev_only_family_state_governor_v1",
    "output_dir": "governor_outputs",
    "allow_paused_stopped_family_planning_override": false
  },
  "research_cycle": {
    "mode": "dev_only_one_pass",
    "full_pipeline_enabled": false,
    "max_planner_jobs": 1,
    "handle_worker_proposal": false,
    "submit_heavy_validation": false,
    "run_heavy_validation_adapter": false,
    "run_critic": false,
    "run_governor": false
  },
  "scanner_paths": [
    "research_os",
    "outputs/research_os/dev_only",
    "configs/families/family_registry.template.json",
    "configs/runtime/runtime_config.pi_orchestrator.template.json"
  ],
  "scanner_env_keys": [
    "COMPUTERNAME",
    "USERNAME",
    "PROCESSOR_ARCHITECTURE"
  ],
  "research_artifacts": [
    {
      "artifact_id": "cash_overstay_diagnostic",
      "family_id": "cash_overstay_diagnostic",
      "artifact_type": "summary",
      "path": "outputs/research_os/dev_only/non_authoritative_cash_diagnostics/cash_overstay_diagnostic.summary.json"
    },
    {
      "artifact_id": "constructive_pilot_probe",
      "family_id": "constructive_regime_pilot_exposure_persistence",
      "artifact_type": "summary",
      "path": "outputs/research_os/dev_only/non_authoritative_constructive_pilot_probe/constructive_pilot_probe.summary.json"
    },
    {
      "artifact_id": "high_conviction_pre_activation_pilot_probe",
      "family_id": "high_conviction_pre_activation_pilot",
      "artifact_type": "summary",
      "path": "outputs/research_os/dev_only/non_authoritative_high_conviction_pre_activation_pilot_probe/high_conviction_pre_activation_pilot_probe.summary.json"
    },
    {
      "artifact_id": "rearmed_high_conviction_pre_activation_pilot_probe",
      "family_id": "high_conviction_pre_activation_pilot",
      "artifact_type": "summary",
      "path": "outputs/research_os/dev_only/non_authoritative_rearmed_high_conviction_pre_activation_pilot_probe/rearmed_high_conviction_pre_activation_pilot_probe.summary.json"
    },
    {
      "artifact_id": "cost_aware_hysteretic_pilot_to_full_probe",
      "family_id": "cost_aware_hysteretic_pilot_to_full",
      "artifact_type": "summary",
      "path": "outputs/research_os/dev_only/non_authoritative_cost_aware_hysteretic_pilot_to_full_probe/cost_aware_hysteretic_pilot_to_full_probe.summary.json"
    },
    {
      "artifact_id": "cost_aware_hysteretic_pilot_to_full_recap_confirm_probe",
      "family_id": "cost_aware_hysteretic_pilot_to_full",
      "artifact_type": "summary",
      "path": "outputs/research_os/dev_only/non_authoritative_cost_aware_hysteretic_pilot_to_full_recap_confirm_probe/cost_aware_hysteretic_pilot_to_full_recap_confirm_probe.summary.json"
    },
    {
      "artifact_id": "supportive_vs_caution_subset_layer_v1",
      "family_id": "descriptive_subset_context",
      "artifact_type": "summary",
      "path": "outputs/research_os/dev_only/non_authoritative_subset_layer/supportive_vs_caution_subset_layer_v1.summary.json"
    },
    {
      "artifact_id": "response_shape_bot_v1_anomaly_aligned_profile",
      "family_id": "response_shape_anomaly_aligned_context",
      "artifact_type": "profile",
      "path": "outputs/research_os/dev_only/non_authoritative_response_shape_aligned/response_shape_bot_v1_anomaly_aligned.profile.json"
    }
  ]
}
