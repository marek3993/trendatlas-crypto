[Unit]
Description=TrendAtlas dependency-scoped maintenance watchdog
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=trendatlas-production
Group=trendatlas-production
WorkingDirectory=/opt/trendatlas-production/current
EnvironmentFile=-/etc/default/trendatlas-watchdog
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/trendatlas-production/current/.venv/bin/python -B /opt/trendatlas-production/current/scripts/execution/mrv1_self_healing_watchdog.py --remediate-safe --ai-diagnose --json
Nice=10
CPUQuota=50%
MemoryMax=1G
TimeoutStartSec=3min
Restart=no
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/trendatlas-production/current/outputs/execution/watchdog
InaccessiblePaths=-/etc/trendatlas-production -/etc/credstore -/etc/credstore.encrypted -/run/credentials -/run/user
InaccessiblePaths=/opt/trendatlas-production/current/scripts/execution/run_trendatlas_production.py /opt/trendatlas-production/current/scripts/execution/run_pi_fast_daily_authority_refresh.py /opt/trendatlas-production/current/scripts/execution/run_pi_authoritative_producer.py
InaccessiblePaths=-/opt/trendatlas-production/current/.env -/opt/trendatlas-production/current/web/.env.local
UMask=0077
StandardOutput=journal
StandardError=journal
