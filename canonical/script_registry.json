{
  "version": 1,
  "purpose": "Central script index for cross-chat code navigation. This is not source_of_truth and not a decision file.",
  "last_updated_note": "Update when a script is added, deprecated, renamed, or materially changes outputs.",
  "scripts": [
    {
      "script_path": "automation/tools/bootstrap_automation.py",
      "layer": "automation",
      "status": "active",
      "purpose": "Creates automation scaffold, config, schemas, templates, and folders.",
      "primary_outputs": [
        "automation/config/automation_config.json",
        "automation/config/task_registry.json",
        "automation/schemas/",
        "automation/templates/"
      ],
      "output_type": "automation_scaffold",
      "decision_relevance": "support_only",
      "writes_source_of_truth": false,
      "notes": "Safe bootstrap only."
    },
    {
      "script_path": "automation/tools/create_run.py",
      "layer": "automation",
      "status": "active",
      "purpose": "Creates task spec, queue entry, run log, report, and screenshot manifest for a new automation run.",
      "primary_outputs": [
        "automation/tasks/specs/",
        "automation/tasks/queue/",
        "automation/runs/",
        "automation/reports/",
        "automation/screenshots/"
      ],
      "output_type": "run_artifacts",
      "decision_relevance": "support_only",
      "writes_source_of_truth": false,
      "notes": "Run initialization only."
    },
    {
      "script_path": "automation/tools/finalize_run.py",
      "layer": "automation",
      "status": "active",
      "purpose": "Finalizes an automation run and moves task record from queue to completed.",
      "primary_outputs": [
        "automation/runs/",
        "automation/reports/",
        "automation/tasks/completed/"
      ],
      "output_type": "run_artifacts",
      "decision_relevance": "support_only",
      "writes_source_of_truth": false,
      "notes": "No SSOT writes."
    },
    {
      "script_path": "automation/tools/create_pending_truth_patch.py",
      "layer": "automation",
      "status": "active",
      "purpose": "Creates pending truth patch proposal linked to a run.",
