        "outputs/execution/runtime_health/"
      ],
      "output_type": "runtime_control",
      "decision_relevance": "support_only",
      "writes_source_of_truth": false,
      "notes": "Default is one pass. Loop mode is explicit only. No SSOT writes and no real orders."
    },
    {
