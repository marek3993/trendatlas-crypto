        "outputs/phase68g_portfolio_exposure_leverage_validation/phase68g_portfolio_exposure_leverage_summary.csv",
        "outputs/phase68g_portfolio_exposure_leverage_validation/phase68g_tradable_transition_calendar.csv"
      ],
      "output_type": "research_outputs",
      "decision_relevance": "decision_relevant",
