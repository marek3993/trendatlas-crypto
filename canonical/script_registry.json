      "decision_relevance": "support_only",
      "writes_source_of_truth": false,
      "notes": "Read-only."
    },
    {
      "script_path": "automation/tools/show_run_summary.py",
      "layer": "automation",
      "status": "active",
      "purpose": "Shows compact run summary including patches and approvals.",
      "primary_outputs": [],
      "output_type": "query",
      "decision_relevance": "support_only",
      "writes_source_of_truth": false,
      "notes": "Read-only."
    },
    {
      "script_path": "automation/tools/reconcile_run_state.py",
