      "decision_relevance": "support_only",
      "writes_source_of_truth": false,
      "notes": "Read-only validator."
    },
    {
      "script_path": "automation/tools/validate_run_bundle.py",
      "layer": "automation",
      "status": "active",
      "purpose": "Validates run bundle artifacts for a specific run_id.",
      "primary_outputs": [],
      "output_type": "validation",
      "decision_relevance": "support_only",
      "writes_source_of_truth": false,
      "notes": "Read-only validator."
    },
    {
      "script_path": "automation/tools/list_truth_patches.py",
      "layer": "automation",
      "status": "active",
      "purpose": "Lists truth patches by status bucket and optional run filter.",
      "primary_outputs": [],
      "output_type": "query",
      "decision_relevance": "support_only",
      "writes_source_of_truth": false,
      "notes": "Read-only."
    },
    {
      "script_path": "automation/tools/list_runs.py",
      "layer": "automation",
      "status": "active",
      "purpose": "Lists automation runs with patch counts and report path.",
      "primary_outputs": [],
