      ],
      "output_type": "pending_truth_patch",
      "decision_relevance": "candidate_truth_input",
      "writes_source_of_truth": false,
      "notes": "Proposal only."
    },
    {
      "script_path": "automation/tools/approve_truth_patch.py",
