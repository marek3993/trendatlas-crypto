        "automation/truth_patches/pending/"
      ],
      "output_type": "pending_truth_patch",
      "decision_relevance": "candidate_truth_input",
      "writes_source_of_truth": false,
      "notes": "Proposal only."
    },
    {
      "script_path": "automation/tools/approve_truth_patch.py",
      "layer": "automation",
      "status": "active",
      "purpose": "Records approval or rejection decision for a pending truth patch and creates approval record.",
      "primary_outputs": [
        "automation/truth_patches/approved/",
        "automation/truth_patches/rejected/",
        "automation/approvals/"
      ],
      "output_type": "approval_artifacts",
      "decision_relevance": "approval_gate",
      "writes_source_of_truth": false,
      "notes": "Approval recorded only. Apply is separate."
    },
    {
      "script_path": "automation/tools/validate_json.py",
      "layer": "automation",
      "status": "active",
      "purpose": "Validates a single automation JSON artifact against required keys and enum rules.",
      "primary_outputs": [],
      "output_type": "validation",
      "decision_relevance": "support_only",
      "writes_source_of_truth": false,
      "notes": "Read-only validator."
    },
    {
      "script_path": "automation/tools/validate_run_bundle.py",
      "layer": "automation",
      "status": "active",
      "purpose": "Validates run bundle artifacts for a specific run_id.",
      "primary_outputs": [],
      "output_type": "validation",
      "decision_relevance": "support_only",
      "writes_source_of_truth": false,
      "notes": "Read-only validator."
    },
    {
      "script_path": "automation/tools/list_truth_patches.py",
      "layer": "automation",
      "status": "active",
      "purpose": "Lists truth patches by status bucket and optional run filter.",
      "primary_outputs": [],
      "output_type": "query",
      "decision_relevance": "support_only",
      "writes_source_of_truth": false,
      "notes": "Read-only."
    },
    {
      "script_path": "automation/tools/list_runs.py",
      "layer": "automation",
      "status": "active",
      "purpose": "Lists automation runs with patch counts and report path.",
      "primary_outputs": [],
      "output_type": "query",
      "decision_relevance": "support_only",
      "writes_source_of_truth": false,
      "notes": "Read-only."
    },
    {
      "script_path": "automation/tools/show_run_summary.py",
      "layer": "automation",
      "status": "active",
      "purpose": "Shows compact run summary including patches and approvals.",
      "primary_outputs": [],
      "output_type": "query",
      "decision_relevance": "support_only",
      "writes_source_of_truth": false,
      "notes": "Read-only."
    },
    {
      "script_path": "automation/tools/reconcile_run_state.py",
      "layer": "automation",
      "status": "active",
      "purpose": "Reconciles report next_action from current patch and approval state.",
      "primary_outputs": [
        "automation/reports/",
        "automation/runs/"
      ],
      "output_type": "run_artifacts",
      "decision_relevance": "support_only",
      "writes_source_of_truth": false,
      "notes": "No SSOT writes."
    },
