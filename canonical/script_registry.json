        "outputs/phase68h_dynamic_leverage_ladder_candidate/"
      ],
      "output_type": "research_outputs",
      "decision_relevance": "decision_relevant",
      "writes_source_of_truth": false,
      "notes": "Tracked separately from automation scope."
    }
