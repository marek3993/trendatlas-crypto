      "notes": "Validated clean by forensic verdict."
    },
    {
      "script_path": "scripts/phase68h_dynamic_leverage_ladder_candidate.py",
      "layer": "forensic_validation",
      "status": "active",
      "purpose": "Phase68H dynamic leverage ladder candidate generation.",
