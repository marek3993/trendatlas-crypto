{
  "schema_version": "2.0",
  "entity": "promotion_decision",
  "required_fields": [
    "decision_id",
    "candidate_id",
    "source_run_id",
    "decision",
    "decision_reason",
    "decided_by",
    "decided_at",
    "evidence_refs"
  ],
  "allowed_decision_values": [
    "kill",
    "hold",
    "rerun",
    "promote_to_precheck",
    "promote_to_forensic",
    "promote_to_master",
    "promote_to_official"
  ],
  "strict_rules": {
    "allow_custom_decision_values": false,
    "allow_unknown_top_level_fields": false
  }
}