{
  "policy_version": "6.0.0",
  "description": "Mechanism-first redesigned family space after exhausted wave1 and wave2.",
  "enabled_families": {
    "regime_reentry_proof": {
      "enabled": true,
      "role": "redesigned_wave1",
      "max_candidates_per_batch": 1
    },
    "leader_fragility_filter": {
      "enabled": true,
      "role": "redesigned_wave1",
      "max_candidates_per_batch": 1
    },
    "recovery_quality_split": {
      "enabled": false,
      "role": "disabled_initially",
      "max_candidates_per_batch": 0
    }
  },
  "blocked_families": [
    "cooldown_tuning_v3",
    "threshold_tuning_v3",
    "ranking_weight_tuning_v4",
    "signal_disagreement_veto",
    "transition_state_machine",
    "trend_acceleration_confirmation",
    "loss_shape_response",
    "probation_rule_tuning",
    "generic_governance_fiddling",
    "generic_tuning_shell",
    "generic_threshold_search",
    "generic_cooldown_change",
    "generic_weight_rebalance",
    "broad_random_search",
    "unbounded_parameter_sweep"
  ],
  "global_required_fields": [
    "family_name",
    "known_baseline_weakness",
    "exact_mechanism_of_improvement",
    "new_state_or_new_classification",
    "exact_compare_target",
    "why_not_parameter_tuning",
    "why_expected_edge_should_survive_strict_scoring",
    "primary_expected_metric_improvement"
  ],
  "allowed_primary_expected_metric_improvement": [
    "CAGR",
    "DD",
    "since2025",
    "Calmar"
  ],
  "family_rules": {
    "regime_reentry_proof": {
      "required_fields": [
        "reentry_proof_sequence_name",
        "follow_through_requirement",
        "persistence_requirement",
        "immediate_reversal_block_rule"
      ],
      "mechanism_first_required": true,
      "parameter_first_forbidden": true
    },
    "leader_fragility_filter": {
      "required_fields": [
        "leader_fragility_signal_name",
        "stability_definition",
        "activation_or_continuation_gate"
      ],
      "mechanism_first_required": true,
      "parameter_first_forbidden": true
    },
    "recovery_quality_split": {
      "required_fields": [
        "recovery_classifier_name",
        "high_quality_vs_weak_recovery_logic",
        "full_risk_on_gate_rule"
      ],
      "mechanism_first_required": true,
      "parameter_first_forbidden": true
    }
  },
  "anti_generic_filters": {
    "reject_hypothesis_text_equal_label": true,
    "reject_if_missing_global_required_fields": true,
    "reject_if_missing_family_required_fields": true,
    "reject_if_vague_phrase_only": [
      "improve robustness",
      "avoid whipsaw",
      "change thresholds",
      "change cooldown",
      "change weights",
      "adjust governance",
      "improve selection quality"
    ],
    "reject_if_generic_only": [
      "parameter change without new state",
      "parameter change without new classification",
      "parameter change without new logical gate"
    ],
    "reject_if_not_mechanism_first": true
  },
  "next_batch_policy": {
    "keep_scoring_strictness": true,
    "max_active_families": 2,
    "max_selected_specs_total": 2,
    "exactly_one_spec_per_active_family": true,
    "active_families": [
      "regime_reentry_proof",
      "leader_fragility_filter"
    ],
    "disabled_initially": [
      "recovery_quality_split",
      "cooldown_tuning_v3",
      "threshold_tuning_v3",
      "ranking_weight_tuning_v4"
    ],
    "if_zero_worthy_again": "stop_autonomous_family_ideation_and_escalate_to_mrv1_master_for_human_designed_hypothesis_reset"
  }
}