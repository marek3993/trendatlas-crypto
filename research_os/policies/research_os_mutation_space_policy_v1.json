{
  "policy_version": "3.0.0",
  "description": "Mutation-space v3 after clean v2 zero-selection audit. Mechanism-first only.",
  "enabled_families": {
    "ranking_weight_tuning_v2": {
      "enabled": true,
      "role": "primary",
      "max_candidates_per_batch": 1
    },
    "cooldown_tuning_v2": {
      "enabled": true,
      "role": "conditional",
      "max_candidates_per_batch": 1
    },
    "threshold_tuning_v2": {
      "enabled": true,
      "role": "conditional",
      "max_candidates_per_batch": 1
    }
  },
  "paused_families": [],
  "blocked_families": [
    "probation_rule_tuning",
    "generic_governance_fiddling",
    "generic_tuning_shell",
    "generic_threshold_search",
    "generic_cooldown_change",
    "generic_weight_rebalance",
    "broad_random_search",
    "unbounded_parameter_sweep"
  ],
  "global_required_fields": [
    "known_baseline_weakness",
    "exact_mechanism_of_improvement",
    "exact_compare_target",
    "exact_failure_mode_being_fixed",
    "why_expected_edge_survives_strict_scoring",
    "primary_expected_metric_improvement"
  ],
  "allowed_primary_expected_metric_improvement": [
    "CAGR",
    "DD",
    "since2025",
    "Calmar"
  ],
  "family_rules": {
    "ranking_weight_tuning_v2": {
      "mechanism_first_required": true,
      "parameter_first_forbidden": true,
      "required_fields": [
        "weight_block_name",
        "current_weight_problem",
        "exact_weight_change",
        "why_this_weight_change_addresses_baseline_weakness",
        "expected_selection_effect"
      ],
      "hard_reason": "most_salvageable_family_but_only_with_exact_weight_block_and_exact_weakness"
    },
    "cooldown_tuning_v2": {
      "mechanism_first_required": true,
      "parameter_first_forbidden": true,
      "single_named_failure_mode_required": true,
      "required_fields": [
        "cooldown_component_name",
        "named_baseline_failure_mode",
        "why_current_cooldown_is_wrong_for_that_failure_mode",
        "exact_cooldown_change",
        "expected_transition_effect"
      ],
      "hard_reason": "allowed_only_if_tied_to_one_explicit_baseline_failure_mode"
    },
    "threshold_tuning_v2": {
      "mechanism_first_required": true,
      "parameter_first_forbidden": true,
      "single_named_failure_mode_required": true,
      "required_fields": [
        "threshold_name",
        "named_failure_mode",
        "why_baseline_threshold_is_wrong",
        "exact_threshold_change",
        "expected_false_positive_or_missed_move_effect"
      ],
      "hard_reason": "allowed_only_as_one_targeted_threshold_fix_against_one_named_failure_mode"
    }
  },
  "anti_generic_filters": {
    "reject_hypothesis_text_equal_label": true,
    "reject_if_missing_global_required_fields": true,
    "reject_if_missing_family_required_fields": true,
    "reject_if_missing_explicit_baseline_weakness": true,
    "reject_if_missing_explicit_mechanism": true,
    "reject_if_missing_explicit_compare_target": true,
    "reject_if_missing_explicit_failure_mode": true,
    "reject_if_missing_primary_expected_metric_improvement": true,
    "reject_if_vague_phrase_only": [
      "improve robustness",
      "reduce whipsaw",
      "tune cooldown",
      "shift threshold",
      "rebalance weights",
      "optimize parameters"
    ],
    "reject_if_generic_only": [
      "generic cooldown change",
      "generic threshold shift",
      "generic weight rebalance"
    ]
  },
  "next_batch_policy": {
    "keep_scoring_strictness": true,
    "max_selected_specs_total": 3,
    "ranking_weight_tuning_v2_max": 1,
    "cooldown_tuning_v2_max": 1,
    "threshold_tuning_v2_max": 1,
    "no_governance_family_reintroduction": true,
    "each_selected_spec_must_be_mechanism_first": true
  }
}