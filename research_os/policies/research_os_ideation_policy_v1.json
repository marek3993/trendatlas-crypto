{
  "policy_version": "7.0.0",
  "description": "Controlled ideation v7 for MASTER-approved human-reset batch.",
  "allowed_branches": [
    "core"
  ],
  "default_segment_owner_by_branch": {
    "core": "core_strategy"
  },
  "global_required_fields": [
    "hypothesis_id",
    "branch",
    "segment_owner",
    "hypothesis_label",
    "hypothesis_text",
    "rationale",
    "baseline_reference",
    "mutation_family",
    "family_name",
    "known_baseline_weakness",
    "exact_mechanism_of_improvement",
    "new_state_or_new_classification",
    "exact_compare_target",
    "why_not_parameter_tuning",
    "why_expected_edge_should_survive_strict_scoring",
    "primary_expected_metric_improvement"
  ],
  "family_specific_required_fields": {
    "baseline_relative_edge_gate": [
      "rolling_excess_edge_reference",
      "short_horizon_edge_gate",
      "medium_horizon_edge_gate",
      "fallback_to_baseline_rule"
    ],
    "breadth_dispersion_corridor": [
      "breadth_measure_name",
      "dispersion_measure_name",
      "healthy_corridor_definition",
      "fallback_to_baseline_rule"
    ],
    "downside_asymmetry_veto": [
      "downside_reference_name",
      "downside_beta_or_capture_measure",
      "downside_cap_rule",
      "promotion_veto_rule"
    ]
  },
  "anti_generic_guards": {
    "reject_if_hypothesis_text_equals_label": true,
    "reject_if_missing_global_required_fields": true,
    "reject_if_missing_family_required_fields": true,
    "reject_if_parameter_first_not_mechanism_first": true,
    "reject_vague_phrases": [
      "improve robustness",
      "avoid whipsaw",
      "change thresholds",
      "change cooldown",
      "change weights",
      "adjust governance",
      "improve selection quality"
    ]
  },
  "allowed_primary_expected_metric_improvement": [
    "CAGR",
    "DD",
    "since2025",
    "Calmar"
  ],
  "generation_limits": {
    "max_selected_specs_total": 3,
    "baseline_relative_edge_gate_max": 1,
    "breadth_dispersion_corridor_max": 1,
    "downside_asymmetry_veto_max": 1
  }
}