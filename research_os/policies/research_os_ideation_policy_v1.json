{
  "policy_version": "8.0.0",
  "description": "Controlled ideation v8 for phase68i dynamic ladder human-seeded first batch.",
  "allowed_branches": [
    "core"
  ],
  "default_segment_owner_by_branch": {
    "core": "core_strategy"
  },
  "global_required_fields": [
    "hypothesis_id",
    "branch",
    "segment_owner",
    "hypothesis_label",
    "hypothesis_text",
    "rationale",
    "baseline_reference",
    "mutation_family",
    "family_name",
    "known_baseline_weakness",
    "exact_mechanism_of_improvement",
    "new_state_or_new_classification",
    "exact_compare_target",
    "why_not_parameter_tuning",
    "why_expected_edge_should_survive_strict_scoring",
    "primary_expected_metric_improvement"
  ],
  "family_specific_required_fields": {
    "ladder_reentry_stability_gate": [
      "reentry_trigger_name",
      "stability_proof_requirement",
      "premature_reentry_block_rule"
    ],
    "ladder_step_fragility_filter": [
      "step_fragility_signal_name",
      "step_up_gate_rule",
      "fragile_state_hold_rule"
    ],
    "ladder_downside_capture_cap": [
      "downside_capture_reference",
      "downside_cap_rule",
      "step_down_or_freeze_rule"
    ]
  },
  "anti_generic_guards": {
    "reject_if_hypothesis_text_equals_label": true,
    "reject_if_missing_global_required_fields": true,
    "reject_if_missing_family_required_fields": true,
    "reject_if_parameter_first_not_mechanism_first": true,
    "reject_vague_phrases": [
      "improve robustness",
      "avoid whipsaw",
      "change thresholds",
      "change cooldown",
      "change weights",
      "adjust governance",
      "improve selection quality"
    ]
  },
  "allowed_primary_expected_metric_improvement": [
    "CAGR",
    "DD",
    "since2025",
    "Calmar"
  ],
  "generation_limits": {
    "max_selected_specs_total": 3,
    "ladder_reentry_stability_gate_max": 1,
    "ladder_step_fragility_filter_max": 1,
    "ladder_downside_capture_cap_max": 1
  }
}
