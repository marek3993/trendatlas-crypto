{
  "policy_version": "2.0.0",
  "description": "Deterministic controlled ideation policy with mandatory edge thesis fields.",
  "allowed_branches": [
    "core"
  ],
  "default_segment_owner_by_branch": {
    "core": "core_strategy"
  },
  "required_fields": [
    "hypothesis_id",
    "branch",
    "segment_owner",
    "hypothesis_label",
    "hypothesis_text",
    "rationale",
    "expected_improvement_direction",
    "baseline_reference",
    "mutation_family",
    "risk_flags",
    "duplicate_suspicion",
    "near_duplicate_suspicion",
    "branch_saturation_state",
    "known_baseline_weakness",
    "failure_mode_being_fixed",
    "explicit_mechanism_of_improvement",
    "exact_compare_target",
    "why_edge_should_survive_scoring_strictness"
  ],
  "baseline_reference_rules": {
    "require_truth_pack_reference": true,
    "require_official_baseline_model_key": true
  },
  "duplicate_rules": {
    "block_exact_duplicates": true,
    "near_duplicate_similarity_threshold": 0.72,
    "label_near_duplicates": true
  },
  "branch_saturation_rules": {
    "warn_threshold": 2,
    "block_threshold": 3,
    "window_latest_hypotheses": 20
  },
  "risk_flag_rules": {
    "required_flag_categories": [
      "instability_risk",
      "complexity_risk",
      "duplicate_risk",
      "saturation_risk"
    ]
  },
  "expected_improvement_direction_allowed": [
    "increase_robustness",
    "reduce_switches",
    "improve_recent_performance"
  ],
  "anti_generic_guards": {
    "reject_if_hypothesis_text_equals_label": true,
    "reject_if_missing_exact_compare_target": true,
    "reject_if_missing_baseline_weakness": true,
    "reject_if_missing_failure_mode": true,
    "reject_if_missing_improvement_mechanism": true,
    "reject_if_missing_scoring_survival_rationale": true
  },
  "safe_outcomes": {
    "broken_context": "fail_fast",
    "duplicate_block": "blocked",
    "saturated_branch_block": "blocked",
    "generic_shell_block": "blocked",
    "valid_hypothesis": "proposed"
  }
}